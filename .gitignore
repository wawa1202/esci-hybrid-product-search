# and validation reports so the documented demo works after dependency setup.
!data/processed/dev-c882caf5632ad442/
!data/processed/dev-c882caf5632ad442/**
!artifacts/dev-indexes-20260926/
!artifacts/dev-indexes-20260926/**
!artifacts/dev-ltr-20260926/
!artifacts/dev-ltr-20260926/**
!reports/validation-20260926/
!reports/validation-20260926/**
!reports/benchmark-20260926.json
!reports/audit-20260926T052441106378Z/
!reports/audit-20260926T052441106378Z/**
!reports/audit-20260926T055548368947Z/
!reports/audit-20260926T055548368947Z/**
!reports/audit-20260926T060337109128Z/
!reports/audit-20260926T060337109128Z/**
